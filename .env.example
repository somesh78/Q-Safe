# ================================
# Django Core Settings
# ================================

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dhgfhbjsblkubffbhsfbgjhsfebgjhsdfhbvsfkvkjsfbvlefbvlfbvljhbeafkvasvlyuabdvuyaflvbeurab

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts (no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1,your-ec2-ip-address,yourdomain.com,www.yourdomain.com

# ================================
# CORS & CSRF Settings
# ================================

# Comma-separated list of allowed origins for CORS (no spaces)
# Include both http/https and with/without www if using domain
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Comma-separated list of CSRF trusted origins (no spaces)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ================================
# Database Configuration
# ================================

# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://username:password@host:5432/q_safe

# SQLite for development/testing (requires 3 slashes for relative path):
# DATABASE_URL=sqlite:///db.sqlite3

# SQLite with absolute path for Docker (requires 4 slashes):
# DATABASE_URL=sqlite:////app/backend/db.sqlite3

# Or leave DATABASE_URL unset to use Django's default SQLite configuration

# ================================
# Redis & Celery Configuration
# ================================

# Redis connection URL (for caching and Celery broker)
REDIS_URL=redis://localhost:6379/0

# Celery broker and result backend (usually same as REDIS_URL)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# For Docker deployment, use:
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# ================================
# Supabase Storage Configuration
# ================================

