SUPABASE_URL=https://rypmvrtsrmnimfkwwkvo.supabase.co

# IMPORTANT: Use the service_role key, NOT the anon key!
# This is required for server-side uploads/downloads
# Found in Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJ5cG12cnRzcm1uaW1ma3d3a3ZvIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3MDIwMzA2NywiZXhwIjoyMDg1Nzc5MDY3fQ.mROM0GpTm7NdL-R0-fAyZMjKkUzfQdtQ0d1Lww8Fg1c

